    <script type="text/javascript">
        //disable click
        function disableRightClick() {
            alert("Sorry, right click is not allowed !!");
            return false;
        }

        //sidemenu
        $(document).ready(function () {
            $('.icon-menu').click(function () {
                $('.menu').animate({
                    left: "0px"
                }, 400);
                $('body').append('<div class="overlay"></div>');
                $('.overlay').show();
            });

            $('.fa-times').click(function () {
                $('.menu').animate({
                    left: "-350px"
                }, 400);
                $('.overlay').remove();
            });
        });
    </script>

